<link rel="stylesheet" href="/public/css/article.css">

<div class="article-detail-container">
    <div class="article-header">
        <a href="/article" class="back-link">← Back to Articles</a>
    </div>

    <article class="article-full">
        <div class="article-author-info">
            <img src="{{article.author_avatar}}" alt="{{article.author_full_name}}" class="article-author-avatar-large">
            <div class="author-details">
                <span class="author-name-large">{{article.author_full_name}}</span>
                <span class="publish-date">{{formatDate article.created_at}}</span>
            </div>
        </div>

        <h1 class="article-title">{{article.title}}</h1>

        {{#if article.image_url}}
            <div class="article-image">
                <img src="{{article.image_url}}" alt="{{article.title}}">
            </div>
        {{/if}}

        <div class="article-content">
            {{{article.content}}}
        </div>

        <div class="article-footer">
            <div class="likes-section">
                <span class="likes-count">❤️ {{#if article.likes_count}}{{article.likes_count}}{{else}}0{{/if}} likes</span>
                {{#if user}}
                    <button id="likeBtn" class="btn-like" onclick="toggleLike({{article.id}})">
                        ❤️ Like
                    </button>
                {{else}}
                    <a href="/user/login" class="btn-login-to-like">Login to like</a>
                {{/if}}
            </div>
        </div>
    </article>

    <div class="comments-section">
        <h3>Comments</h3>
        <div id="commentsContainer" class="comments-container">
            <div id="commentsList" class="comments-list">

            </div>
        </div>
    </div>

    {{#if user}}
        {{#if (eq user.id article.author_id)}}
            <div class="article-actions">
                <a href="/article/{{article.id}}/edit" class="btn btn-edit">Edit Article</a>
            </div>
        {{/if}}
    {{/if}}
</div>

<script>
    async function toggleLike(articleId) {
        try {
            const res = await fetch(`/article/${articleId}/like`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                }
            });

            if (res.ok) {
                const data = await res.json();
                const likesCountEl = document.querySelector('.likes-count');
                likesCountEl.textContent = `❤️ ${data.likesCount} likes`;

                const likeBtn = document.getElementById('likeBtn');
                if (data.liked) {
                    likeBtn.classList.add('liked');
                } else {
                    likeBtn.classList.remove('liked');
                }
            }
        } catch (e) {
            console.error('Like error:', e);
        }
    }
</script>

<script>
    const articleId = {{article.id}};

    async function loadComments(){
        const res = await fetch(`/comment/article/${articleId}`);
        const data = await res.json();

        const commentsList = document.getElementById('commentsList');
        commentsList.innerHTML = renderComments(data.comments, null, 0);
    }

    /**
     * Recursively render comments with nested replies support
     * @param {Array} comments - Array of all comment objects
     * @param {number|null} parentId - Parent comment ID to filter by (null for top-level comments)
     * @param {number} level - Current nesting depth level (0 for top-level, increases for replies)
     * @returns {string} HTML string of rendered comments
     */
    function renderComments(comments, parentId, level) {
        // Filter comments that belong to the current parent
        const filtered = comments.filter(comment => comment.parent_id === parentId);

        // Base case: return empty string if no comments found at this level
        if (filtered.length === 0) return '';

        // Start container for this level of comments
        let html = '<div class="comments-nested">';

        filtered.forEach(comment => {
            // Determine CSS class and indentation based on nesting level
            const marginLeft = level * 30;

            //Build comment HTML structure
            html += '<div class="comment-item" style="margin-left: ' + marginLeft + 'px">';
            html += '  <div class="comment-header">';
            html += '    <img src="' + (comment.avatar_url || '/public/avatarImages/default.png') + '" alt="' + comment.username + '" class="comment-avatar">';
            html += '    <div class="comment-info">';
            html += '      <span class="comment-author">' + (comment.full_name || comment.username) + '</span>';
            html += '      <span class="comment-date">' + formatDate(comment.created_at) + '</span>';
            html += '    </div>';
            html += '  </div>';
            html += '  <div class="comment-content">' + escapeHtml(comment.content) + '</div>';
            html += '</div>';

            // Recursive call: render child comments (replies to this comment)
            html += renderComments(comments, comment.id, level + 1);
        });

        html += '</div>';
        return html;
    }

    function escapeHtml(text) {
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }

    function formatDate(dateStr) {
        const date = new Date(dateStr);
        return date.toLocaleString('en-US', {
            year: 'numeric',
            month: 'short',
            day: 'numeric',
            hour: '2-digit',
            minute: '2-digit'
        });
    }
    loadComments();
</script>