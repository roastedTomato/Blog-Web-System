<link rel="stylesheet" href="https://cdn.quilljs.com/1.3.7/quill.snow.css">
<link rel="stylesheet" href="/public/css/article.css">

<div class="article-form-container">
    <div class="form-header">
        <h1>{{#if isEdit}}Edit Article{{else}}Create New Article{{/if}}</h1>
        <a href="/article/my" class="btn btn-cancel">Cancel</a>
    </div>

    <form id="articleForm" class="article-form" enctype="multipart/form-data">
        <div class="form-group">
            <label for="title">Title *</label>
            <input type="text" id="title" name="title" value="{{article.title}}"
                   required
                   placeholder="Enter article title">
        </div>

        <div class="form-group">
            <label for="image">Article Image (optional)</label>
            {{#if isEdit}}
                {{#if article.image_url}}
                    <div class="current-image">
                        <p>Current image:</p>
                        <img src="{{article.image_url}}" alt="Current image" id="currentImage">
                        <button type="button" onclick="removeImage()" class="btn-remove-image">Remove Image</button>
                    </div>
                {{/if}}
            {{/if}}

            <input type="file" id="image" name="image" accept="image/*">
            <small>Accepted formats: JPG, PNG, GIF. Max size: 5MB</small>
        </div>

        <div class="form-group">
            <label>Content *</label>
            <div id="editor"></div>
            <input type="hidden" id="content" name="content" value="{{article.content}}">
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-submit">{{#if isEdit}}Update Article{{else}}Publish Article{{/if}}</button>
        </div>
    </form>
</div>

<script src="https://cdn.quilljs.com/1.3.7/quill.min.js"></script>
<script>
    //1.WYSIWYG editor
    const quill = new Quill('#editor', {
        theme: 'snow',
        modules: {
            toolbar: [
                [{ 'header': [1, 2, 3, false] }],
                ['bold', 'italic', 'underline'],
                [{ 'list': 'ordered'}, { 'list': 'bullet' }],
                ['clean']
            ]
        },
        placeholder: 'Write your article content here...'
    });

    const initialContent = '{{{json article.content}}}' || '';
    if (initialContent && initialContent !== '') {
        quill.root.innerHTML = initialContent;
    }

    const form = document.getElementById('articleForm');
    const contentInput = document.getElementById('content');
    const isEditMode = {{#if isEdit}}true{{else}}false{{/if}};
    const articleId = '{{article.id}}';

    /**
     * Reads an error message from either a JSON or plain-text response.
     */
    async function getErrorMessage(response) {
        const contentType = response.headers.get('content-type') || '';
        if (contentType.includes('application/json')) {
            const data = await response.json();
            return data.error || 'Failed to save article';
        }
        return await response.text();
    }

    /**
     * Handles create and edit form submission through fetch.
     * Uses POST for new articles and PUT for existing articles.
     */
    form.addEventListener('submit', async function(e) {
        e.preventDefault();

        // Keep the hidden form field in sync with the WYSIWYG editor before upload.
        contentInput.value = quill.root.innerHTML;

        const formData = new FormData(form);

        try {
            let url = isEditMode ? `/article/${articleId}` : '/article';
            let method = isEditMode ? 'PUT' : 'POST';

            const response = await fetch(url, {
                method: method,
                body: formData
            });

            if (!response.ok) {
                throw new Error(await getErrorMessage(response));
            }

            window.location.href = '/article/my';
        } catch (error) {
            console.error('Submit error:', error);
            alert(error.message || 'Failed to save article');
        }
    });

        {{#if isEdit}}
        /**
         * Marks the current article image for removal in edit mode.
         * The hidden input tells the server to set image_url to null.
         */
        function removeImage() {
            if (confirm('Remove this image?')) {
                // Hide the current image preview immediately for visual feedback
                document.getElementById('currentImage').style.display = 'none';

                // Create a hidden input field to mark image removal
                const hiddenInput = document.createElement('input');
                hiddenInput.type = 'hidden';
                hiddenInput.name = 'removeImage';
                hiddenInput.value = 'true';

                // Append the hidden field to the form so it will be submitted with formData
                document.getElementById('articleForm').appendChild(hiddenInput);
            }
        }
        {{/if}}

</script>
