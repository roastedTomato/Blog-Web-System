<link rel="stylesheet" href="/public/css/register.css">

<div class="register-container">
    <h2>User Registration</h2>

    {{#if error}}
        <div class="error-message">
            {{error}}
        </div>
    {{/if}}

    {{#if success}}
        <div class="success-message">
            {{success}}
        </div>
    {{/if}}

    <form action="/user/register" method="post" class="register-form">
        <div class="form-group">
            <label for="username">Username *</label>
            <input type="text"
                   id="username"
                   name="username"
                   required
                   minlength="3"
                   maxlength="50"
                   placeholder="Enter username"
                   value="{{formData.username}}"
            >
            <span id="username-status" class="username-status"></span>
            <small>3-50 characters, must be unique</small>
        </div>

        <div class="form-group">
            <label for="password">Password *</label>
            <input
                    type="password"
                    id="password"
                    name="password"
                    required
                    minlength="6"
                    placeholder="Enter password"
            >
            <small>At least 6 characters</small>
        </div>

        <div class="form-group">
            <label for="confirmPassword">Confirm Password *</label>
            <input
                    type="password"
                    id="confirmPassword"
                    name="confirmPassword"
                    required
                    placeholder="Re-enter password"
            >
            <span id="password-status" class="password-status"></span>
        </div>

        <div class="form-group">
            <label for="fullName">Full Name</label>
            <input
                    type="text"
                    id="fullName"
                    name="fullName"
                    required
                    maxlength="100"
                    placeholder="Enter your full name"
                    value="{{formData.fullName}}"
            >
        </div>

        <div class="form-group">
            <label for="birthday">Birthday</label>
            <input
                    type="date"
                    id="birthday"
                    name="birthday"
                    required
                    value="{{formData.birthday}}"
            >
            <small>Select your birthdate</small>
        </div>

        <div class="form-group">
            <label for="bio">Biography</label>
            <textarea
                    id="bio"
                    name="bio"
                    rows="4"
                    required
                    maxlength="500"
                    placeholder="Tell us about yourself..."
            >{{formData.bio}}</textarea>
            <small>Maximum 500 characters</small>
        </div>

        <div class="form-group">
            <label for="avatar">Choose Avatar</label>
            <div class="avatar-selection">
                {{#each avatars}}
                    <div class="avatar-option">
                        <input
                                type="radio"
                                id="avatar-{{this.id}}"
                                name="avatarId"
                                value="{{this.id}}"
                                {{#if this.selected}}checked{{/if}}
                        >

                        <label for="avatar-{{this.id}}">
                            <img src="{{this.icon_path}}" alt="{{this.name}}" class="avatar-preview">
                            <span>{{this.name}}</span>
                        </label>
                    </div>
                {{/each}}
            </div>
        </div>

        <button type="submit" class="btn btn-register">Register</button>
    </form>

    <P class="login-link">
        Already have an account? <a href="/user/login">Login here</a>
    </P>
</div>

<script>
    const registerForm = document.querySelector('.register-form');
    const usernameInput = document.getElementById('username');
    const usernameStatus = document.getElementById('username-status');
    const passwordInput = document.getElementById('password');
    const confirmPasswordInput = document.getElementById('confirmPassword');
    const passwordStatus = document.getElementById('password-status');
    let checkTimeout = null;

    /**
     * Waits briefly after username typing before checking availability.
     * This avoids sending a request for every single key press.
     */
    usernameInput.addEventListener('input',function(){
        const username = this.value.trim();

        if(checkTimeout){
            clearTimeout(checkTimeout);
        }

        usernameStatus.className = 'username-status';
        usernameStatus.textContent='';

        if(username === ''){
            return;
        }

        checkTimeout = setTimeout(()=>{
            checkUsernameAvailability(username);
        },500)
    });

    /**
     * Checks username availability by calling the backend AJAX endpoint.
     * Updates the message below the username field with the result.
     */
    async function checkUsernameAvailability(username){
        usernameStatus.textContent = 'Checking...';
        usernameStatus.className = 'username-status checking';

        try {
            const response = await fetch(`/user/check-username?username=${encodeURIComponent(username)}`);
            const data = await response.json();

            if (data.available) {
                usernameStatus.textContent = '✓ ' + data.message;
                usernameStatus.className = 'username-status available';
            } else {
                usernameStatus.textContent = '✗ ' + data.message;
                usernameStatus.className = 'username-status taken';
            }
        } catch (e) {
            console.error('Username check error:', e);
            usernameStatus.textContent = 'Unable to check username right now';
            usernameStatus.className = 'username-status taken';
        }
    }

    /**
     * Checks whether the two password fields match.
     * Returns false when the form should not be submitted.
     */
    function validatePasswords() {
        const password = passwordInput.value;
        const confirmPassword = confirmPasswordInput.value;

        if (!confirmPassword) {
            passwordStatus.textContent = '';
            passwordStatus.className = 'password-status';
            return true;
        }

        if (password !== confirmPassword) {
            passwordStatus.textContent = 'Passwords do not match';
            passwordStatus.className = 'password-status invalid';
            return false;
        }

        passwordStatus.textContent = 'Passwords match';
        passwordStatus.className = 'password-status valid';
        return true;
    }

    passwordInput.addEventListener('input', validatePasswords);
    confirmPasswordInput.addEventListener('input', validatePasswords);

    /**
     * Prevents form submission if password confirmation is invalid.
     */
    registerForm.addEventListener('submit', function(event) {
        if (!validatePasswords()) {
            event.preventDefault();
            confirmPasswordInput.focus();
        }
    });
</script>
