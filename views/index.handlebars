<link rel="stylesheet" href="/public/css/home.css">
<link rel="stylesheet" href="/public/css/article.css">

<div class="home-container">
    <h1>Welcome to Our Blog Platform</h1>

    {{#if user}}
        <div class="user-info">
            <p>Hello, {{user.fullName}}({{user.username}})! ^^</p>
        </div>
        <div class="action-buttons">
            <a href="/user/profile" class="btn btn-editProfile">Edit Profile</a>
            <a href="/user/logout" class="btn btn-logout" onclick="return confirm('Are you sure you want to logout?')">Logout</a>
        </div>

    {{else}}
        <p>Please register or login to continue.</p>
        <div class="action-buttons">
            <a href="/user/register" class="btn btn-register">Register</a>
            <a href="/user/login" class="btn btn-login">Login</a>
        </div>
    {{/if}}
</div>

<hr class="section-divider">

<div class="articles-preview">
    <div class="list-header">
        <h2>Latest Articles</h2>

        <form action="/" method="get" class="sort-form">
            <label>Sort by：</label>
            <select name="sort" onchange="this.form.submit()">
                <option value="date" {{#if (eq currentSort 'date')}}selected{{/if}}>Publish date</option>
                <option value="title" {{#if (eq currentSort 'title')}}selected{{/if}}>Title</option>
                <option value="username" {{#if (eq currentSort 'username')}}selected{{/if}}>Username</option>
            </select>

            <select name="order" onchange="this.form.submit()">
                <option value="DESC" {{#if (eq currentOrder 'DESC')}}selected{{/if}}>Desc</option>
                <option value="ASC" {{#if (eq currentOrder 'ASC')}}selected{{/if}}>Asc</option>
            </select>
        </form>
    </div>

    {{#if articles.length}}
        <div class="articles-simple-list">
            {{#each articles}}
                <article class="article-simple-item">
                    <img src="{{this.author_avatar}}" alt="author-avatar" class="article-avatar">

                    <div class="article-info">
                        <h3 class="article-simple-title">
                            <span>{{this.title}}</span>
                        </h3>
                        <div class="article-simple-meta">
                            <span class="author-name">{{this.author_full_name}}</span>
                            <span class="article-date">{{formatDate this.created_at}}</span>
                        </div>
                    </div>
                    <a href="/article/{{this.id}}" class="link-read-more">Read more</a>
                </article>
            {{/each}}
        </div>
    {{else}}
        <div class="no-articles">
            <p>No article yet.</p>
        </div>
    {{/if}}
</div>